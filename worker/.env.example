# ------------------------------------------------------------------------------
# Worker en ejecución local fuera de Docker
# ------------------------------------------------------------------------------
#
# WORKER_ID y WORKER_CONTROL_PLANE_BASE_URL son el contrato técnico de arranque.
# El resto de variables mantiene el flujo local actual hasta que #28 sustituya
# el JSON local y las credenciales de destino por el contrato runtime remoto.

WORKER_ID=local-worker
WORKER_CONTROL_PLANE_BASE_URL=http://localhost:8000

WORKER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WORKER_KAFKA_CLIENT_ID=cdc-sync-worker
WORKER_KAFKA_GROUP_ID=cdc-sync-worker
WORKER_KAFKA_AUTO_OFFSET_RESET=earliest
WORKER_KAFKA_POLL_TIMEOUT_MS=1000

WORKER_TABLE_CONFIG_PATH=config/tables.json

WORKER_CLICKHOUSE_HOST=localhost
WORKER_CLICKHOUSE_PORT=9000
WORKER_CLICKHOUSE_SECURE=false
WORKER_CLICKHOUSE_DB=cdc_sync_analytics
WORKER_CLICKHOUSE_USER=cdc_sync
WORKER_CLICKHOUSE_PASSWORD=cdc_sync
