# ------------------------------------------------------------------------------
# PostgreSQL
# Variables usadas por docker-compose para el servicio base de PostgreSQL.
# ------------------------------------------------------------------------------

# Nombre de la base de datos inicial.
POSTGRES_DB=cdc_sync

# Usuario administrador creado al inicializar el contenedor.
POSTGRES_USER=cdc_sync

# Contrasena del usuario administrador.
POSTGRES_PASSWORD=cdc_sync

# Puerto publicado en el host para conectarse desde herramientas locales.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# ZooKeeper
# Servicio de coordinacion requerido por Kafka en esta fase del stack local.
# ------------------------------------------------------------------------------

# Puerto publicado en el host para clientes locales o validaciones manuales.
ZOOKEEPER_PORT=2181

# Tiempo base de latido del nodo de ZooKeeper.
ZOOKEEPER_TICK_TIME=2000

# ------------------------------------------------------------------------------
# Kafka
# Broker unico de desarrollo para la mensajeria del stack local.
# ------------------------------------------------------------------------------

# Identificador del broker dentro del cluster local.
KAFKA_BROKER_ID=1

# Puerto publicado en el host para clientes externos a Docker.
KAFKA_PORT=9092

# Factor de replicacion minimo para topics internos en un cluster de un solo nodo.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Topic tecnico de prueba para validar publicacion y consumo en desarrollo.
KAFKA_TEST_TOPIC=cdc-sync-test

# ------------------------------------------------------------------------------
# Debezium Connect
# Servicio base de Kafka Connect para registrar conectores CDC.
# ------------------------------------------------------------------------------

# Bootstrap server interno usado por Kafka Connect dentro de Docker.
CONNECT_BOOTSTRAP_SERVERS=kafka:29092

# Identificador del grupo distribuido de Kafka Connect.
CONNECT_GROUP_ID=1

# Topics internos usados por Kafka Connect para configuracion, offsets y estado.
CONNECT_CONFIG_STORAGE_TOPIC=connect_configs
CONNECT_OFFSET_STORAGE_TOPIC=connect_offsets
CONNECT_STATUS_STORAGE_TOPIC=connect_statuses

# Factores de replicacion ajustados a un entorno local de un solo broker.
CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR=1
CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR=1
CONNECT_STATUS_STORAGE_REPLICATION_FACTOR=1

# Host y puerto expuestos para la API REST de Kafka Connect.
CONNECT_REST_HOST_NAME=0.0.0.0
CONNECT_PORT=8083

# ------------------------------------------------------------------------------
# Debezium PostgreSQL source connector
# Configuracion del primer conector CDC de ejemplo.
# ------------------------------------------------------------------------------

# En local pueden mantenerse en .env. En otros entornos, las credenciales no deben
# versionarse y deberian inyectarse desde el sistema de despliegue.

# Identificacion del conector en Kafka Connect.
DEBEZIUM_POSTGRES_CONNECTOR_NAME=postgres-cdc-source

# Conexion con la base OLTP de origen.
DEBEZIUM_POSTGRES_HOST=postgres
DEBEZIUM_POSTGRES_PORT=5432
DEBEZIUM_POSTGRES_DB=cdc_sync
DEBEZIUM_POSTGRES_USER=cdc_sync
DEBEZIUM_POSTGRES_PASSWORD=cdc_sync

# Tablas capturadas explicitamente por el conector.
DEBEZIUM_POSTGRES_TABLE_INCLUDE_LIST=public.customers,public.orders

# Prefijo de topics Kafka para los eventos CDC emitidos por PostgreSQL.
DEBEZIUM_POSTGRES_TOPIC_PREFIX=cdc_sync

# Slot y publication usados por pgoutput para este conector.
DEBEZIUM_POSTGRES_SLOT_NAME=cdc_sync_slot
DEBEZIUM_POSTGRES_PUBLICATION_NAME=cdc_sync_publication
