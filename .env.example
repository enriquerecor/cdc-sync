# ------------------------------------------------------------------------------
# PostgreSQL OLTP local
# Variables usadas por docker-compose para el servicio de origen de ejemplo.
# ------------------------------------------------------------------------------

# Nombre de la base de datos inicial.
POSTGRES_DB=cdc_sync

# Usuario administrador creado al inicializar el contenedor.
POSTGRES_USER=cdc_sync

# Contraseña del usuario administrador.
POSTGRES_PASSWORD=cdc_sync

# Puerto publicado en el host para conectarse desde herramientas locales.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# API REST del control plane
# Variables técnicas de la API dentro del stack local.
# ------------------------------------------------------------------------------

# Puerto publicado en el host para la API REST.
API_PORT=8000

# Nombre visible del servicio en OpenAPI.
API_NAME="cdc-sync control plane"

# Versión inicial de la API.
API_VERSION=0.1.0

# URL interna de Kafka Connect para futuras operaciones del control plane.
API_KAFKA_CONNECT_BASE_URL=http://connect:8083

# Bootstrap server interno que la API publica en el contrato runtime del worker.
API_WORKER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Prefijo para derivar el client_id runtime de cada worker.
API_WORKER_KAFKA_CLIENT_ID_PREFIX=cdc-sync-worker

# Estrategia de lectura inicial incluida en el contrato runtime del worker.
API_WORKER_KAFKA_AUTO_OFFSET_RESET=earliest

# Tiempo máximo de poll incluido en el contrato runtime del worker.
API_WORKER_KAFKA_POLL_TIMEOUT_MS=1000

# PostgreSQL propio del control plane.
CONTROL_PLANE_POSTGRES_DB=cdc_sync_control_plane
CONTROL_PLANE_POSTGRES_USER=cdc_sync_control_plane
CONTROL_PLANE_POSTGRES_PASSWORD=cdc_sync_control_plane
CONTROL_PLANE_POSTGRES_PORT=5433

# Configuración técnica del engine SQLAlchemy.
API_DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# ZooKeeper
# Servicio de coordinación requerido por Kafka en esta fase del stack local.
# ------------------------------------------------------------------------------

# Puerto publicado en el host para clientes locales o validaciones manuales.
ZOOKEEPER_PORT=2181

# Tiempo base de latido del nodo de ZooKeeper.
ZOOKEEPER_TICK_TIME=2000

# ------------------------------------------------------------------------------
# Kafka
# Broker único de desarrollo para la mensajería del stack local.
# ------------------------------------------------------------------------------

# Identificador del broker dentro del cluster local.
KAFKA_BROKER_ID=1

# Puerto publicado en el host para clientes externos a Docker.
KAFKA_PORT=9092

# Factor de replicación mínimo para topics internos en un cluster de un solo nodo.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Topic técnico de prueba para validar publicación y consumo en desarrollo.
KAFKA_TEST_TOPIC=cdc-sync-test

# ------------------------------------------------------------------------------
# Debezium Connect
# Servicio base de Kafka Connect para registrar conectores CDC.
# ------------------------------------------------------------------------------

# Bootstrap server interno usado por Kafka Connect dentro de Docker.
CONNECT_BOOTSTRAP_SERVERS=kafka:29092

# Identificador del grupo distribuido de Kafka Connect.
CONNECT_GROUP_ID=1

# Topics internos usados por Kafka Connect para configuración, offsets y estado.
CONNECT_CONFIG_STORAGE_TOPIC=connect_configs
CONNECT_OFFSET_STORAGE_TOPIC=connect_offsets
CONNECT_STATUS_STORAGE_TOPIC=connect_statuses

# Factores de replicación ajustados a un entorno local de un solo broker.
CONNECT_CONFIG_STORAGE_REPLICATION_FACTOR=1
CONNECT_OFFSET_STORAGE_REPLICATION_FACTOR=1
CONNECT_STATUS_STORAGE_REPLICATION_FACTOR=1

# Host y puerto expuestos para la API REST de Kafka Connect.
CONNECT_REST_HOST_NAME=0.0.0.0
CONNECT_PORT=8083

# ------------------------------------------------------------------------------
# Worker local
# Variables técnicas mínimas de arranque del worker stateless.
# ------------------------------------------------------------------------------

# Identificador funcional del worker usado para pedir su contrato runtime.
WORKER_ID=local-worker

# URL interna de la API dentro de Docker.
WORKER_CONTROL_PLANE_BASE_URL=http://api:8000

# ------------------------------------------------------------------------------
# ClickHouse
# Base analítica de destino para fases posteriores del pipeline CDC.
# ------------------------------------------------------------------------------

# Versión de la imagen Docker usada para el servicio local.
CLICKHOUSE_VERSION=25.10

# Base de datos inicial creada al arrancar el contenedor.
CLICKHOUSE_DB=cdc_sync_analytics

# Credenciales locales del servicio ClickHouse.
CLICKHOUSE_USER=cdc_sync
CLICKHOUSE_PASSWORD=cdc_sync

# Puertos expuestos para HTTP y protocolo nativo.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Habilita la gestión de usuarios con el usuario configurado por variables.
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# ------------------------------------------------------------------------------
# Demo e2e multi-worker
# Configuración del runner local de la demo ERP/CRM.
# ------------------------------------------------------------------------------

# Workers soportados por la demo. Cada worker recibe un módulo funcional.
DEMO_WORKER_IDS=crm-worker,sales-worker,operations-worker

# Fichero temporal donde la demo guarda IDs creados por la API.
DEMO_STATE_FILE=.tmp/e2e-demo-state.json

# Tiempo máximo para esperar la convergencia OLTP -> OLAP en demo-assert.
DEMO_ASSERT_TIMEOUT_SECONDS=120
