# ------------------------------------------------------------------------------
# PostgreSQL
# Variables usadas por docker-compose para el servicio base de PostgreSQL.
# ------------------------------------------------------------------------------

# Nombre de la base de datos inicial.
POSTGRES_DB=cdc_sync

# Usuario administrador creado al inicializar el contenedor.
POSTGRES_USER=cdc_sync

# Contrasena del usuario administrador.
POSTGRES_PASSWORD=cdc_sync

# Puerto publicado en el host para conectarse desde herramientas locales.
POSTGRES_PORT=5432
