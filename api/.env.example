# ------------------------------------------------------------------------------
# API REST del control plane en ejecución local fuera de Docker
# ------------------------------------------------------------------------------

API_PORT=8000
API_NAME="cdc-sync control plane"
API_VERSION=0.1.0
API_KAFKA_CONNECT_BASE_URL=http://localhost:8083
API_WORKER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
API_WORKER_KAFKA_CLIENT_ID_PREFIX=cdc-sync-worker
API_WORKER_KAFKA_AUTO_OFFSET_RESET=earliest
API_WORKER_KAFKA_POLL_TIMEOUT_MS=1000

# PostgreSQL propio del control plane publicado en el host por Docker Compose.
API_DATABASE_HOST=localhost
API_DATABASE_PORT=5433
API_DATABASE_NAME=cdc_sync_control_plane
API_DATABASE_USER=cdc_sync_control_plane
API_DATABASE_PASSWORD=cdc_sync_control_plane
API_DATABASE_ECHO=false
